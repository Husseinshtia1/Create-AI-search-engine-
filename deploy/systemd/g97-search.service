[Unit]
Description=G97 Live Search HTTP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=g97
Group=g97
WorkingDirectory=/opt/g97
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/g97/.venv/bin/g97-live --data-dir /var/lib/g97 serve --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/g97
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
